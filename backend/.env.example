NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
ALLOWED_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Generate two different high-entropy secrets. Never commit real values.
JWT_ACCESS_SECRET=Harshiv
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=12h
JWT_REMEMBER_REFRESH_EXPIRES_IN=30d

PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional development-only demo account. Disabled by default.
SEED_DEMO_USER=false
SEED_DEMO_LOGIN=admin
SEED_DEMO_EMAIL=admin@example.com
SEED_DEMO_COMPANY=My Company
SEED_DEMO_PASSWORD=
